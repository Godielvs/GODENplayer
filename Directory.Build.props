<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GodenEnableQaHooks Condition="'$(GodenEnableQaHooks)'==''">0</GodenEnableQaHooks>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <SdkRoot Condition="'$(SdkRoot)'==''">$(RepoRoot)out\dependencies\foobar2000-sdk\SDK-2025-03-07</SdkRoot>
    <Fb2kSdkRoot>$(SdkRoot)\foobar2000</Fb2kSdkRoot>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
    <PlatformToolset>v142</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <!-- Conservative by default on the shared 16 GiB workstation. -->
    <NekoBuildWorkers Condition="'$(NekoBuildWorkers)'==''">1</NekoBuildWorkers>
    <CL_MPCount Condition="'$(CL_MPCount)'==''">$(NekoBuildWorkers)</CL_MPCount>
    <MultiProcMaxCount Condition="'$(MultiProcMaxCount)'==''">$(NekoBuildWorkers)</MultiProcMaxCount>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/cgthreads:$(NekoBuildWorkers) %(AdditionalOptions)</AdditionalOptions>
      <AdditionalLibraryDirectories>$(RepoRoot)out\third_party\zstd\$(Configuration)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>zstd_static.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
