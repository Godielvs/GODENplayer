+/// <summary>
+/// Wakes the event-idle renderer when the Goden root window is restored.
+/// Child UI elements do not receive a size/position notification when only
+/// their ancestor changes iconic state, so the root chrome broadcasts this
+/// registered message to every descendant.
+/// </summary>
+UINT uielement_t::RootPresentationVisibilityMessage() noexcept
+{
+    static const auto message = ::RegisterWindowMessageW(
+        L"Goden.RootPresentationVisibility.V1");
+    return message;
+}
+
+LRESULT uielement_t::OnRootPresentationVisibility(UINT, WPARAM, LPARAM)
+{
+    WakeRenderer();
+    Invalidate();
+    SetMsgHandled(FALSE);
+    return 0;
+}
+
 /// <summary>
 /// Gets the graph that contains the specified point.
