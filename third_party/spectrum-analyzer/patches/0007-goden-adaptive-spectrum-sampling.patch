+/// <summary>
+/// Resamples the fixed 120-note analysis for presentation only. Downsampling
+/// keeps the strongest note in each group so audible notes do not disappear;
+/// upsampling interpolates in log-frequency between the original anchors.
+/// </summary>
+void spectrum_t::UpdateNekoRenderBands(size_t renderBandCount) noexcept
+{
+    const auto & source = _Analysis->_FrequencyBands;
+    const auto & shadow = _NekoDoubleExposure.Shadow();
+    const size_t sourceCount = source.size();
+
+    _NekoRenderBands.resize(renderBandCount);
+    const bool hasShadow = shadow.size() == sourceCount;
+
+    if (renderBandCount <= sourceCount)
+    {
+        for (size_t targetIndex = 0; targetIndex < renderBandCount;
+            ++targetIndex)
+        {
+            const size_t first = targetIndex * sourceCount / renderBandCount;
+            const size_t last = std::max(first + 1,
+                (targetIndex + 1) * sourceCount / renderBandCount);
+            const size_t middle = first + (last - first - 1) / 2;
+            auto & target = _NekoRenderBands[targetIndex];
+            target = {};
+            target.Lo = source[first].Lo;
+            target.Center = std::sqrt(
+                source[first].Center * source[last - 1].Center);
+            target.HasDarkBackground = source[middle].HasDarkBackground;
+
+            for (size_t sourceIndex = first; sourceIndex < last;
+                ++sourceIndex)
+            {
+                const auto & band = source[sourceIndex];
+                target.Value = std::max(target.Value, band.Value);
+                target.MaxValue = std::max(target.MaxValue, band.MaxValue);
+                target.Opacity = std::max(target.Opacity, band.Opacity);
+                if (hasShadow)
+                    target.Shadow = std::max(
+                        target.Shadow, shadow[sourceIndex]);
+            }
+        }
+        return;
+    }
+
+    for (size_t targetIndex = 0; targetIndex < renderBandCount; ++targetIndex)
+    {
+        const double position = renderBandCount == 1 || sourceCount == 1
+            ? 0.
+            : (double) targetIndex * (double) (sourceCount - 1) /
+                (double) (renderBandCount - 1);
+        const size_t lower = (size_t) std::floor(position);
+        const size_t upper = std::min(lower + 1, sourceCount - 1);
+        const double fraction = position - (double) lower;
+        const auto & a = source[lower];
+        const auto & b = source[upper];
+        auto & target = _NekoRenderBands[targetIndex];
+        target.Value = std::lerp(a.Value, b.Value, fraction);
+        target.MaxValue = std::lerp(a.MaxValue, b.MaxValue, fraction);
+        target.Opacity = std::lerp(a.Opacity, b.Opacity, fraction);
+        target.Lo = std::exp(std::lerp(
+            std::log(a.Lo), std::log(b.Lo), fraction));
+        target.Center = std::exp(std::lerp(
+            std::log(a.Center), std::log(b.Center), fraction));
+        target.HasDarkBackground =
+            source[(size_t) std::llround(position)].HasDarkBackground;
+        target.Shadow = hasShadow
+            ? std::lerp(shadow[lower], shadow[upper], fraction)
+            : 0.;
+    }
+}
