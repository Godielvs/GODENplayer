+    struct spectrum_color_curve_v2_t
+    {
+        static constexpr size_t Count = 13;
+        std::array<double, Count> X{};
+        std::array<double, Count> Y{
+            -12., -10., -6., -3., -1., 0., 0., 1.5, 2.5, 0., -3., -7., -12.
+        };
+        std::array<double, Count> M{};
+
+        spectrum_color_curve_v2_t() noexcept
+        {
+            constexpr std::array<double, Count> Frequency{
+                20., 31.5, 63., 125., 250., 500., 1000., 2000.,
+                4000., 8000., 12000., 16000., 20000.
+            };
+            std::array<double, Count - 1> h{};
+            std::array<double, Count - 1> delta{};
+            for (size_t i = 0; i < Count; ++i)
+                X[i] = std::log(Frequency[i]);
+            for (size_t i = 0; i + 1 < Count; ++i)
+            {
+                h[i] = X[i + 1] - X[i];
+                delta[i] = (Y[i + 1] - Y[i]) / h[i];
+            }
+
+            const auto endpoint = [](double h0, double h1,
+                double d0, double d1) noexcept
+            {
+                double result = ((2. * h0 + h1) * d0 - h0 * d1) /
+                    (h0 + h1);
+                if (result * d0 <= 0.) return 0.;
+                if ((d0 * d1 < 0.) && (std::abs(result) > std::abs(3. * d0)))
+                    return 3. * d0;
+                return result;
+            };
+            M[0] = endpoint(h[0], h[1], delta[0], delta[1]);
+            M[Count - 1] = endpoint(h[Count - 2], h[Count - 3],
+                delta[Count - 2], delta[Count - 3]);
+            for (size_t i = 1; i + 1 < Count; ++i)
+            {
+                if (delta[i - 1] * delta[i] <= 0.)
+                {
+                    M[i] = 0.;
+                    continue;
+                }
+                const double w1 = 2. * h[i] + h[i - 1];
+                const double w2 = h[i] + 2. * h[i - 1];
+                M[i] = (w1 + w2) /
+                    ((w1 / delta[i - 1]) + (w2 / delta[i]));
+            }
+        }
+
+        double Evaluate(double frequency) const noexcept
+        {
+            const double x = std::log(std::clamp(frequency, 20., 20000.));
+            if (x <= X.front()) return Y.front();
+            if (x >= X.back()) return Y.back();
+            const auto upper = std::upper_bound(X.begin(), X.end(), x);
+            const size_t i = static_cast<size_t>(upper - X.begin() - 1);
+            const double h = X[i + 1] - X[i];
+            const double t = (x - X[i]) / h;
+            const double t2 = t * t;
+            const double t3 = t2 * t;
+            return (2. * t3 - 3. * t2 + 1.) * Y[i] +
+                (t3 - 2. * t2 + t) * h * M[i] +
+                (-2. * t3 + 3. * t2) * Y[i + 1] +
+                (t3 - t2) * h * M[i + 1];
+        }
+    };
+
+    inline double PerceptualCorrectionDb(double frequency) noexcept
+    {
+        static const spectrum_color_curve_v2_t Curve;
+        return Curve.Evaluate(frequency);
+    }
+
+    inline D2D1_COLOR_F SpectrumColorV2(
+        const nekorox::interop::SharedThemeSnapshotV2 & theme,
+        double normalizedValue,
+        double frequency,
+        double minimumDb,
+        double maximumDb) noexcept
+    {
+        const double rawDb = minimumDb +
+            std::clamp(normalizedValue, 0., 1.) * (maximumDb - minimumDb);
+        const double correctedDb = rawDb + PerceptualCorrectionDb(frequency);
+        const D2D1_COLOR_F accent = Color(theme.accent);
+        const FLOAT neutralAmount = SmoothStep((FLOAT) ((rawDb + 80.) / 30.));
+        const D2D1_COLOR_F neutral = Mix(
+            D2D1::ColorF(0x151515, accent.a),
+            D2D1::ColorF(0x333637, accent.a),
+            neutralAmount);
+        const FLOAT accentAmount = SmoothStep((FLOAT) ((correctedDb + 50.) / 22.));
+        // Restore the old Musical Spectrum white impact without discarding
+        // the perceptual colour threshold. Dense masters rarely reached the
+        // narrow -18..-10 dB knee after smoothing, so the strongest notes
+        // could remain accent-coloured forever. The legacy top quarter is a
+        // stable second path to white while corrected dB still decides when
+        // colour first becomes audible.
+        const FLOAT perceptualHighlight = SmoothStep(
+            (FLOAT) ((correctedDb + 20.) / 10.));
+        const FLOAT legacyHighlight = SmoothStep(
+            (FLOAT) ((std::clamp(normalizedValue, 0., 1.) -
+                HighlightStart) / (HighlightFull - HighlightStart)));
+        const FLOAT highlightAmount = (std::max)(
+            perceptualHighlight, legacyHighlight);
+        return Mix(
+            Mix(neutral, accent, accentAmount),
+            D2D1::ColorF(D2D1::ColorF::White, accent.a),
+            highlightAmount);
+    }
