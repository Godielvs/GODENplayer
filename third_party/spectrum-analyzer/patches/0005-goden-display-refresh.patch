+void uielement_t::RefreshDisplayEnvironment() noexcept
+{
+    const auto root = ::GetAncestor(m_hWnd, GA_ROOT);
+    _DisplayMonitor.store(::MonitorFromWindow(
+        root != nullptr ? root : m_hWnd,
+        MONITOR_DEFAULTTONEAREST), std::memory_order_release);
+    if (_D3DDevice == nullptr)
+        return;
+
+    CComPtr<IDXGIDevice1> dxgiDevice;
+    if (FAILED(_D3DDevice->QueryInterface(&dxgiDevice)))
+        return;
+    double refreshRate = 0.;
+    if (SUCCEEDED(_Direct2D.GetRefreshRate(
+            dxgiDevice, m_hWnd, refreshRate)) &&
+        std::isfinite(refreshRate) && refreshRate >= 24.)
+        _DisplayRefreshRate = refreshRate;
+}
