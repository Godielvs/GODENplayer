diff --git a/Visuals/Spectrum/NekoDoubleExposure.h b/Visuals/Spectrum/NekoDoubleExposure.h
new file mode 100644
index 0000000000000000000000000000000000000000..3ee6f4eaf88ebd99b317a00a8050614049d50e29
--- /dev/null
+++ b/Visuals/Spectrum/NekoDoubleExposure.h
@@ -0,0 +1,78 @@
+/** $VER: NekoDoubleExposure.h (2026.07.28) NekoRoX - Frame-rate independent artwork shadow for the bar spectrum. **/
+
+#pragma once
+
+#include "FrequencyBand.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+class neko_double_exposure_t final
+{
+public:
+    static constexpr double ShadowAttackSeconds = 0.028;
+    static constexpr double ShadowReleaseSeconds = 0.460;
+    static constexpr double MaximumFrameSeconds = 0.050;
+
+    void Reset() noexcept
+    {
+        _Shadow.clear();
+        _IsInitialized = false;
+    }
+
+    void Update(const frequency_bands_t & bands, double frameSeconds) noexcept
+    {
+        if (bands.empty())
+        {
+            Reset();
+            return;
+        }
+
+        const size_t count = bands.size();
+
+        if (_Shadow.size() != count)
+        {
+            _Shadow.resize(count);
+            _IsInitialized = false;
+        }
+
+        if (!_IsInitialized)
+        {
+            for (size_t i = 0; i < count; ++i)
+                _Shadow[i] = std::clamp(bands[i].Value, 0., 1.);
+
+            _IsInitialized = true;
+            return;
+        }
+
+        const double dt = std::clamp(frameSeconds, 0., MaximumFrameSeconds);
+
+        for (size_t i = 0; i < count; ++i)
+        {
+            const double value = std::clamp(bands[i].Value, 0., 1.);
+            const double shadowTau = (value >= _Shadow[i])
+                ? ShadowAttackSeconds : ShadowReleaseSeconds;
+
+            _Shadow[i] = Approach(_Shadow[i], value, dt, shadowTau);
+        }
+    }
+
+    const std::vector<double> & Shadow() const noexcept { return _Shadow; }
+
+private:
+    static double Approach(double current, double target, double dt, double timeConstant) noexcept
+    {
+        if (dt <= 0.)
+            return current;
+
+        const double blend = 1. - std::exp(-dt / timeConstant);
+
+        return std::clamp(current + ((target - current) * blend), 0., 1.);
+    }
+
+private:
+    std::vector<double> _Shadow;
+    bool _IsInitialized = false;
+};
diff --git a/Visuals/Spectrum/NekoVisualPalette.h b/Visuals/Spectrum/NekoVisualPalette.h
new file mode 100644
index 0000000000000000000000000000000000000000..ba357413bf058e8e79c18810af2d64b64a886f7e
--- /dev/null
+++ b/Visuals/Spectrum/NekoVisualPalette.h
@@ -0,0 +1,175 @@
+/** $VER: NekoVisualPalette.h (2026.07.28) NekoRoX - Shared artwork palette and spectrum surface constraints. **/
+
+#pragma once
+
+#include "NekoThemeProvider.h"
+#include "Style.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace nekorox_visual
+{
+    inline constexpr double LegacyDarkMid = 0.25;
+    inline constexpr double LegacyDarkHigh = 0.50;
+    inline constexpr double HighlightStart = 0.75;
+    inline constexpr double HighlightFull = 1.00;
+
+    inline D2D1_COLOR_F Mix(const D2D1_COLOR_F & from, const D2D1_COLOR_F & to, FLOAT progress) noexcept
+    {
+        progress = std::clamp(progress, 0.f, 1.f);
+
+        return
+        {
+            from.r + ((to.r - from.r) * progress),
+            from.g + ((to.g - from.g) * progress),
+            from.b + ((to.b - from.b) * progress),
+            from.a + ((to.a - from.a) * progress)
+        };
+    }
+
+    inline FLOAT SmoothStep(FLOAT value) noexcept
+    {
+        value = std::clamp(value, 0.f, 1.f);
+        return value * value * (3.f - (2.f * value));
+    }
+
+    inline FLOAT Luminance(const D2D1_COLOR_F & color) noexcept
+    {
+        return (0.2126f * color.r) + (0.7152f * color.g) + (0.0722f * color.b);
+    }
+
+    inline D2D1_COLOR_F Color(const nekorox::interop::SharedRgbaColorV1 & value) noexcept
+    {
+        return D2D1::ColorF(value.red, value.green, value.blue, value.alpha);
+    }
+
+    inline bool RefreshSharedTheme(
+        service_ptr_t<nekorox::interop::ThemeProviderV1> & provider,
+        nekorox::interop::SharedThemeSnapshotV2 & snapshot) noexcept
+    {
+        try
+        {
+            if (!provider.is_valid())
+            {
+                service_enum_t<nekorox::interop::ThemeProviderV1> providers;
+                if (!providers.first(provider))
+                    return false;
+            }
+
+            nekorox::interop::SharedThemeSnapshotV2 candidate;
+            if (!provider->getSnapshot(candidate) ||
+                !nekorox::interop::validSharedThemeSnapshot(candidate))
+                return false;
+
+            snapshot = candidate;
+            return true;
+        }
+        catch (...)
+        {
+            return false;
+        }
+    }
+
+    inline D2D1_COLOR_F AmplitudeColor(
+        const nekorox::interop::SharedThemeSnapshotV2 & theme,
+        double value) noexcept
+    {
+        const FLOAT amplitude = std::clamp((FLOAT) value, 0.f, 1.f);
+        const D2D1_COLOR_F accent = Color(theme.accent);
+        const D2D1_COLOR_F darkLow = D2D1::ColorF(0x151515, accent.a);
+        const D2D1_COLOR_F darkMid = D2D1::ColorF(0x1F1F1F, accent.a);
+        const D2D1_COLOR_F darkHigh = D2D1::ColorF(0x2A2A2A, accent.a);
+
+        // The x86 Musical Spectrum palette was, high to low: white, teal,
+        // #2A2A2A, #1F1F1F, #151515. Preserve that transfer topology while
+        // substituting the artwork accent for its single chromatic teal stop.
+        if (amplitude < (FLOAT) LegacyDarkMid)
+            return Mix(darkLow, darkMid, SmoothStep(
+                amplitude / (FLOAT) LegacyDarkMid));
+
+        if (amplitude < (FLOAT) LegacyDarkHigh)
+            return Mix(darkMid, darkHigh, SmoothStep(
+                (amplitude - (FLOAT) LegacyDarkMid) /
+                ((FLOAT) LegacyDarkHigh - (FLOAT) LegacyDarkMid)));
+
+        if (amplitude < (FLOAT) HighlightStart)
+            return Mix(darkHigh, accent, SmoothStep(
+                (amplitude - (FLOAT) LegacyDarkHigh) /
+                ((FLOAT) HighlightStart - (FLOAT) LegacyDarkHigh)));
+
+        const FLOAT highlight = SmoothStep((amplitude - (FLOAT) HighlightStart) /
+            ((FLOAT) HighlightFull - (FLOAT) HighlightStart));
+        return Mix(accent, D2D1::ColorF(D2D1::ColorF::White, accent.a), highlight);
+    }
+
+    inline void SetSolidBrushColor(ID2D1Brush * brush, const D2D1_COLOR_F & color) noexcept
+    {
+        if (brush == nullptr)
+            return;
+
+        CComPtr<ID2D1SolidColorBrush> solidBrush;
+
+        if (SUCCEEDED(brush->QueryInterface(IID_PPV_ARGS(&solidBrush))))
+            solidBrush->SetColor(color);
+    }
+
+    inline void ApplyAmplitudeColor(
+        style_t * style,
+        const nekorox::interop::SharedThemeSnapshotV2 & theme,
+        double value) noexcept
+    {
+        if ((style == nullptr) || !style->IsAmplitudeBased())
+            return;
+
+        SetSolidBrushColor(style->_Brush, AmplitudeColor(theme, value));
+    }
+
+    inline D2D1_COLOR_F ArtworkShadowColor(
+        const nekorox::interop::SharedThemeSnapshotV2 & theme,
+        double amplitude) noexcept
+    {
+        const FLOAT level = std::clamp((FLOAT) amplitude, 0.f, 1.f);
+        const D2D1_COLOR_F base = D2D1::ColorF(0x080909);
+        const D2D1_COLOR_F accent = Color(theme.accent);
+        const D2D1_COLOR_F secondary = Color(theme.secondary);
+        const D2D1_COLOR_F shadowHue = Mix(secondary, accent, 0.28f + 0.22f * level);
+        D2D1_COLOR_F result = Mix(base, shadowHue, 0.12f + (0.30f * level));
+
+        const FLOAT luminance = Luminance(result);
+        if (luminance > 0.17f)
+        {
+            const FLOAT scale = 0.17f / luminance;
+            result.r *= scale;
+            result.g *= scale;
+            result.b *= scale;
+        }
+        result.a = 0.72f;
+
+        return result;
+    }
+
+    inline void ApplyNeutralAxisColors(style_t * lineStyle, style_t * textStyle) noexcept
+    {
+        if (lineStyle != nullptr)
+            SetSolidBrushColor(lineStyle->_Brush, D2D1::ColorF(0x20282A, 0.42f));
+
+        if (textStyle != nullptr)
+            SetSolidBrushColor(textStyle->_Brush, D2D1::ColorF(0x536669, 0.78f));
+    }
+
+    inline void ApplyNeutralGraphBackground(style_t * backgroundStyle) noexcept
+    {
+        if (backgroundStyle != nullptr)
+            SetSolidBrushColor(backgroundStyle->_Brush, D2D1::ColorF(0x080909));
+    }
+
+    inline void ApplyNeutralBarBackgroundColors(style_t * darkStyle, style_t * lightStyle) noexcept
+    {
+        if (darkStyle != nullptr)
+            SetSolidBrushColor(darkStyle->_Brush, D2D1::ColorF(0x0A0C0D));
+
+        if (lightStyle != nullptr)
+            SetSolidBrushColor(lightStyle->_Brush, D2D1::ColorF(0x0D1112));
+    }
+}
