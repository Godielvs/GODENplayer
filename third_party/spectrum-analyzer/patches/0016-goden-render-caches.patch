+// Opt-in native QA. No counters, clocks or extra work on production frames.
+UINT uielement_t::SpectrumRenderQaMessage() noexcept
+{
+    static const UINT message = ::RegisterWindowMessageW(L"Goden.SpectrumRenderQa.V1");
+    return message;
+}
+
+LRESULT uielement_t::OnSpectrumRenderQa(UINT, WPARAM field, LPARAM)
+{
+    WCHAR enabled[4] = {};
+    if (::GetEnvironmentVariableW(L"NEKOROX_QA_HOOKS", enabled, 4) != 1 ||
+            enabled[0] != L'1') return E_ACCESSDENIED;
+    if (!_CriticalSection.TryEnter()) return E_PENDING;
+    LRESULT result = E_INVALIDARG;
+    if (field == 0) {
+        const auto fps = _FrameCounter.FrameRateForQa();
+        result = std::isfinite(fps) && fps > 0.f
+            ? static_cast<LRESULT>(fps * 1000.f) : 0;
+    } else if (field == 1) {
+        // Exercise the ordinary resource teardown/recreation path under its
+        // existing render lock, including while paused or hidden.
+        DeleteDeviceSpecificResources();
+        if (_hRenderWake) ::SetEvent(_hRenderWake);
+        result = 1;
+    }
+    _CriticalSection.Leave();
+    return result;
+}
