@@ -390,6 +395,29 @@ void uielement_t::Render() noexcept
 /// </summary>
 void uielement_t::Animate() noexcept
 {
+    if (_PauseReleaseFinalFrame)
+    {
+        _PauseReleaseFinalFrame = false;
+        return;
+    }
+
+    if (_PauseReleaseActive)
+    {
+        const double frameSeconds = 1. / (double) (std::max)(
+            _RenderState._RefreshRateLimit, (int64_t) 1);
+        bool active = false;
+        for (auto & Iter : _Grid)
+            active = Iter._Graph->ReleaseToSilence(frameSeconds) || active;
+        if (!active)
+        {
+            for (auto & Iter : _Grid)
+                Iter._Graph->Reset();
+            _PauseReleaseActive = false;
+            _PauseReleaseFinalFrame = true;
+        }
+        return;
+    }
+
     if (_UIState._PeakMode == PeakMode::None)
         return;
 
