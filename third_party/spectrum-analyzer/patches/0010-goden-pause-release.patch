+/// <summary>
+/// Releases the visible spectrum and its peak layer toward the baseline.
+/// This is deliberately independent of the configured peak-hold mode: pause
+/// is a transport transition, not another frozen analysis frame.
+/// </summary>
+bool analysis_t::ReleaseToSilence(double frameSeconds) noexcept
+{
+    const double dt = std::clamp(frameSeconds, 0.0005, 0.050);
+    const auto release = [dt](double value, double timeConstant) noexcept
+    {
+        const double amount = 1. - std::exp(-dt / timeConstant);
+        value += (0. - value) * amount;
+        return std::abs(value) <= 0.0005 ? 0. : value;
+    };
+
+    bool active = false;
+    for (auto & fb : _FrequencyBands)
+    {
+        fb.Value = release(fb.Value, 0.115);
+        fb.MaxValue = release(fb.MaxValue, 0.130);
+        fb.Opacity = release(fb.Opacity, 0.130);
+        fb.HoldTime = 0.;
+        fb.DecaySpeed = 0.;
+        active = active || fb.Value != 0. || fb.MaxValue != 0.;
+    }
+    return active;
+}
