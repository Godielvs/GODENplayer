+constexpr size_t MaxArtworkBytes = 32U * 1024U * 1024U;
+constexpr uint64_t MaxArtworkPixels = 64ULL * 1024ULL * 1024ULL;
+
+HRESULT ScaledSource(IWICBitmapSource * source, UINT edge, IWICBitmapSource ** result) noexcept
+{
+    UINT width = 0, height = 0;
+    HRESULT hr = source->GetSize(&width, &height);
+    if (FAILED(hr) || !width || !height) return E_INVALIDARG;
+    if (std::max(width, height) <= edge) return source->QueryInterface(IID_PPV_ARGS(result));
+    CComPtr<IWICBitmapScaler> scaler;
+    hr = _WIC.Factory->CreateBitmapScaler(&scaler);
+    const double ratio = static_cast<double>(edge) / std::max(width, height);
+    if (SUCCEEDED(hr)) hr = scaler->Initialize(source,
+        std::max(1U, static_cast<UINT>(std::lround(width * ratio))),
+        std::max(1U, static_cast<UINT>(std::lround(height * ratio))), WICBitmapInterpolationModeFant);
+    if (SUCCEEDED(hr)) hr = scaler->QueryInterface(IID_PPV_ARGS(result));
+    return hr;
+}
+}
